# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=finflow
MYSQL_USER=finflow
MYSQL_PASSWORD=finflowpassword

# JWT
JWT_SECRET=your-256-bit-secret-key-for-jwt-token-generation
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Spring
SPRING_PROFILES_ACTIVE=dev

# CORS - frontend origin(s) allowed to call the API (comma-separated).
# IMPORTANT (prod): set this to the deployed frontend origin, e.g. https://<your-app>.onrender.com
# Otherwise cors returns HTTP 403 "Invalid CORS request" on cross-origin calls.
FRONTEND_URL=http://localhost:3000
