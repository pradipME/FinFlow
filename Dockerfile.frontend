# ── Build frontend ──
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ── Serve with nginx ──
FROM nginx:alpine

# Non-root, production-safe nginx:
# - Keep runtime temp/log paths under /tmp (world-writable) so nginx can run
#   even as a restricted/non-root user.
# - chown the html dir so the nginx worker can serve indexes.
COPY --from=build /app/dist /usr/share/nginx/html
RUN mkdir -p /tmp/nginx && chown -R nginx:nginx /tmp/nginx \
    && chown -R nginx:nginx /usr/share/nginx/html

# Replace the stock main config (temp paths, logs) and add the server block.
COPY nginx.conf /etc/nginx/nginx.conf
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
